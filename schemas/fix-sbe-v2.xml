<?xml version="1.0" encoding="UTF-8"?>
<!--
  FIX messages as SBE, v2.

  APPEND-ONLY over v1. Fields and groups are added at the end; nothing is
  reordered, retyped or removed. A v2 codec decoding a v1 message reads
  actingVersion from the MessageHeader and returns the null value for anything
  added after that version - which is what tests/RingBuffer.Codecs.Tests
  SchemaEvolutionTests asserts.

  Reordering or removing would break every message ever written.

  Two messages, both carrying repeating groups, chosen so that group handling
  cannot hide: MarketDataIncrementalRefresh nests NoPartyIDs inside NoMDEntries.
  Nesting is where flyweight limit management goes wrong, because the inner group
  advances the shared Limit cursor on the parent message.

  See knowledge/decisions/d8-schema-selection.md.

  Evolution rule: v2 may only APPEND. Reordering or removing breaks every message
  ever written. See schemas/fix-sbe-v2.xml.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="RingBuffer.Codecs.V2"
                   id="1"
                   version="1"
                   semanticVersion="4.4"
                   description="FIX 4.4 subset carried over the ring buffer"
                   byteOrder="littleEndian">

  <types>
    <!-- ── framing composites ─────────────────────────────────────────── -->
    <composite name="messageHeader" description="Template and schema identity, prefixes every message">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId"  primitiveType="uint16"/>
      <type name="schemaId"    primitiveType="uint16"/>
      <type name="version"     primitiveType="uint16"/>
    </composite>

    <composite name="groupSizeEncoding" description="Repeating group dimensions">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="numInGroup"  primitiveType="uint16"/>
    </composite>

    <composite name="varStringEncoding" description="UTF-8 variable-length string">
      <type name="length"  primitiveType="uint32" maxValue="1073741824"/>
      <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
    </composite>

    <!-- ── field types ────────────────────────────────────────────────── -->
    <composite name="Decimal64" description="Mantissa and exponent; no floating point on the wire">
      <type name="mantissa" primitiveType="int64"/>
      <type name="exponent" primitiveType="int8"/>
    </composite>

    <type name="ClOrdID"  primitiveType="char" length="20" characterEncoding="ASCII"/>
    <type name="Symbol"   primitiveType="char" length="8"  characterEncoding="ASCII"/>
    <type name="PartyID"  primitiveType="char" length="16" characterEncoding="ASCII"/>
    <type name="UTCTimestampNanos" primitiveType="uint64" description="Nanoseconds since the UNIX epoch"/>

    <enum name="Side" encodingType="char">
      <validValue name="BUY">1</validValue>
      <validValue name="SELL">2</validValue>
    </enum>

    <enum name="OrdType" encodingType="char">
      <validValue name="MARKET">1</validValue>
      <validValue name="LIMIT">2</validValue>
    </enum>

    <enum name="PartyIDSource" encodingType="char">
      <validValue name="PROPRIETARY">D</validValue>
      <validValue name="BIC">B</validValue>
    </enum>

    <enum name="MDEntryType" encodingType="char">
      <validValue name="BID">0</validValue>
      <validValue name="OFFER">1</validValue>
      <validValue name="TRADE">2</validValue>
    </enum>

    <enum name="MDUpdateAction" encodingType="uint8">
      <validValue name="NEW">0</validValue>
      <validValue name="CHANGE">1</validValue>
      <validValue name="DELETE">2</validValue>
    </enum>
  </types>

  <!-- ══ NewOrderSingle ══ single-level repeating group ═════════════════ -->
  <sbe:message name="NewOrderSingle" id="1" description="FIX 35=D">
    <field name="clOrdId"      id="11" type="ClOrdID"/>
    <field name="symbol"       id="55" type="Symbol"/>
    <field name="side"         id="54" type="Side"/>
    <field name="ordType"      id="40" type="OrdType"/>
    <field name="orderQty"     id="38" type="uint32"/>
    <field name="price"        id="44" type="Decimal64"/>
    <field name="transactTime" id="60" type="UTCTimestampNanos"/>

    <!-- v2 addition, appended to the END OF THE FIELD BLOCK. This grows
         blockLength; a v2 decoder reading a v1 message sees v1's smaller
         actingBlockLength and returns the null value. -->
    <field name="minQty" id="110" type="uint32" sinceVersion="1"/>

    <group name="parties" id="453" dimensionType="groupSizeEncoding" description="FIX NoPartyIDs">
      <field name="partyId"       id="448" type="PartyID"/>
      <field name="partyIdSource" id="447" type="PartyIDSource"/>
      <field name="partyRole"     id="452" type="uint8"/>
    </group>

    <!-- v2 addition, appended AFTER the existing group and BEFORE the data
         section, which is the only legal place for a new group. -->
    <group name="allocations" id="78" dimensionType="groupSizeEncoding" sinceVersion="1"
           description="FIX NoAllocs, added in v2">
      <field name="allocAccount" id="79" type="PartyID"/>
      <field name="allocQty"     id="80" type="uint32"/>
    </group>

    <data name="account" id="1" type="varStringEncoding"/>
  </sbe:message>

  <!-- ══ MarketDataIncrementalRefresh ══ NESTED repeating group ═════════ -->
  <sbe:message name="MarketDataIncrementalRefresh" id="2" description="FIX 35=X">
    <field name="transactTime" id="60" type="UTCTimestampNanos"/>

    <group name="mdEntries" id="268" dimensionType="groupSizeEncoding" description="FIX NoMDEntries">
      <field name="mdUpdateAction" id="279" type="MDUpdateAction"/>
      <field name="mdEntryType"    id="269" type="MDEntryType"/>
      <field name="symbol"         id="55"  type="Symbol"/>
      <field name="mdEntryPx"      id="270" type="Decimal64"/>
      <field name="mdEntrySize"    id="271" type="int64"/>

      <!-- Nested. This is the point of the schema: the inner group advances the
           parent message's shared Limit cursor. -->
      <group name="parties" id="453" dimensionType="groupSizeEncoding">
        <field name="partyId"   id="448" type="PartyID"/>
        <field name="partyRole" id="452" type="uint8"/>
      </group>

      <data name="text" id="58" type="varStringEncoding"/>
    </group>
  </sbe:message>

</sbe:messageSchema>
